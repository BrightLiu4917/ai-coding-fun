# deepv4 二审配置。
# 复制到目标项目 .agent/deepv4.env，并且不要提交到 git。

# OpenAI-compatible API base URL，例如 https://api.deepseek.com/v1。
DEEPV4_BASE_URL='https://api.example.com/v1'

# API Key。真实 key 只能写在 .agent/deepv4.env，不要写进模板、README 或 OpenSpec。
DEEPV4_API_KEY='replace-with-your-key'

# 模型名称，按你的服务商实际名称填写。
DEEPV4_MODEL='deepv4'

# 采样温度。审查任务建议低温度，减少随机性。
DEEPV4_TEMPERATURE='0.1'

# 建连超时时间，单位秒。
DEEPV4_CONNECT_TIMEOUT_SECONDS='10'

# 完整请求超时时间，单位秒。模型慢时可以调大。
DEEPV4_TIMEOUT_SECONDS='180'

# 实际执行二审的 provider 脚本。默认使用 OpenAI-compatible 请求格式。
DEEPV4_REVIEW_COMMAND='bash scripts/providers/deepv4-openai-compatible.sh'
