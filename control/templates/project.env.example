# 项目本地覆盖配置。
# 复制到目标项目 .agent/project.env，并且不要提交到 git。
# 可提交的项目画像放在 .ai-control/project.env；本文件只放本机覆盖项。

# 留空时 .ai-control/control/scripts/run-tests.sh 会先读取 .ai-control/project.env，再按项目根目录自动识别测试命令。
# 示例：
# PROJECT_TEST_COMMAND='cd api && ./mvnw test && cd .. && cd vue && npm run build'
PROJECT_TEST_COMMAND=''

# 访问控制模式：
# pending  = 待确认，进入实现前必须确认
# local    = 本服务建设 RBAC
# external = 外部系统、网关、IAM 或 SSO 负责访问控制
# none     = 当前项目或功能不适用访问控制，必须写清原因和风险
ACCESS_CONTROL_MODE='pending'
