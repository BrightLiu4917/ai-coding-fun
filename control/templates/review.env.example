# 独立二审配置。
# 复制到目标项目 .agent/review.env，并且不要提交到 git。

# 模型端点。openai-compatible provider 填 OpenAI 兼容地址（DeepSeek/Kimi/通义/GLM/GPT/Ollama 均可）；
# anthropic provider 可留空（默认 https://api.anthropic.com）。
REVIEW_BASE_URL='https://api.deepseek.com/v1'

# API Key。真实 key 只能写在 .agent/review.env，不要写进模板、README 或 OpenSpec。
REVIEW_API_KEY='replace-with-your-key'

# 模型名，例如 deepseek-reasoner / kimi-k2 / claude-sonnet-5。
REVIEW_MODEL='deepseek-reasoner'

# provider: openai-compatible 或 anthropic（Claude 官方 Messages API）。
REVIEW_PROVIDER='openai-compatible'

# 触发策略: auto = lite 变更自动跳过并记录；always = 一律二审；never = 一律跳过并记录。
REVIEW_MODE='auto'

# 采样温度（仅 openai-compatible）。
REVIEW_TEMPERATURE='0.1'

# 连接超时（秒）。
REVIEW_CONNECT_TIMEOUT_SECONDS='10'

# 总超时（秒）。
REVIEW_TIMEOUT_SECONDS='180'

# 外发 diff 体积上限（字节），超限截断。
# REVIEW_DIFF_MAX_BYTES='512000'

# 兼容说明：旧的 DEEPV4_* 变量和 .agent/deepv4.env 仍可被读取，但建议迁移到本文件。

# 也可用本机 CLI 做二审（复用订阅，无需 API key；每次全新会话，独立性天然满足）：
# REVIEW_PROVIDER='claude-cli'   # 需要已安装 Claude Code（claude 命令）
# REVIEW_PROVIDER='codex-cli'    # 需要已安装 Codex CLI（codex 命令）
# REVIEW_CLI_MODEL=''            # 可选，claude-cli 透传 --model
# REVIEW_CLI_ARGS=''             # 可选，原样透传参数
